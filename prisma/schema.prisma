generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  FLEET_MANAGER
  DRIVER
  SAFETY_OFFICER
  FINANCIAL_ANALYST
}

enum VehicleStatus {
  AVAILABLE
  ON_TRIP
  IN_SHOP
  RETIRED
}

enum DriverStatus {
  AVAILABLE
  ON_TRIP
  OFF_DUTY
  SUSPENDED
}

enum TripStatus {
  DRAFT
  DISPATCHED
  COMPLETED
  CANCELLED
}

enum MaintenanceStatus {
  OPEN
  CLOSED
}

enum ExpenseCategory {
  TOLL
  PARKING
  MAINTENANCE
  OTHER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(FLEET_MANAGER)
  driver       Driver?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Vehicle {
  id                 String          @id @default(cuid())
  registrationNumber String          @unique
  name               String
  model              String?
  type               String
  maxLoadCapacity    Decimal         @db.Decimal(12, 2)
  odometer           Decimal         @db.Decimal(14, 2)
  acquisitionCost    Decimal         @db.Decimal(14, 2)
  status             VehicleStatus   @default(AVAILABLE)
  region             String?
  trips              Trip[]
  maintenanceLogs    MaintenanceLog[]
  fuelLogs           FuelLog[]
  expenses           Expense[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([status])
  @@index([type])
  @@index([region])
}

model Driver {
  id                String       @id @default(cuid())
  userId            String?      @unique
  user              User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  name              String
  licenseNumber     String       @unique
  licenseCategory   String
  licenseExpiryDate DateTime
  contactNumber     String
  safetyScore       Decimal      @default(100) @db.Decimal(5, 2)
  status            DriverStatus @default(AVAILABLE)
  trips             Trip[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([status])
  @@index([licenseExpiryDate])
}

model Trip {
  id               String     @id @default(cuid())
  reference        String     @unique
  source           String
  destination      String
  vehicleId        String
  vehicle          Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driverId         String
  driver           Driver     @relation(fields: [driverId], references: [id], onDelete: Restrict)
  cargoWeight      Decimal    @db.Decimal(12, 2)
  plannedDistance  Decimal    @db.Decimal(12, 2)
  actualDistance   Decimal?   @db.Decimal(12, 2)
  finalOdometer    Decimal?   @db.Decimal(14, 2)
  revenue          Decimal?   @db.Decimal(14, 2)
  status           TripStatus @default(DRAFT)
  dispatchedAt     DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  fuelLogs         FuelLog[]
  expenses         Expense[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([status])
  @@index([vehicleId, status])
  @@index([driverId, status])
}

model MaintenanceLog {
  id          String            @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  description String
  status      MaintenanceStatus @default(OPEN)
  openedAt    DateTime          @default(now())
  closedAt    DateTime?
  cost        Decimal           @default(0) @db.Decimal(14, 2)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([vehicleId, status])
}

model FuelLog {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  tripId    String?
  trip      Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
  liters    Decimal  @db.Decimal(12, 2)
  cost      Decimal  @db.Decimal(14, 2)
  odometer  Decimal? @db.Decimal(14, 2)
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([vehicleId, loggedAt])
  @@index([tripId])
}

model Expense {
  id        String          @id @default(cuid())
  vehicleId String
  vehicle   Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  tripId    String?
  trip      Trip?           @relation(fields: [tripId], references: [id], onDelete: SetNull)
  category  ExpenseCategory
  amount    Decimal         @db.Decimal(14, 2)
  note      String?
  incurredAt DateTime       @default(now())
  createdAt DateTime        @default(now())

  @@index([vehicleId, incurredAt])
  @@index([tripId])
}
